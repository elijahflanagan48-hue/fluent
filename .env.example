FLUENT_BASE_URL=http://127.0.0.1:4174
# Production: absolute persistent directory mounted into both app and worker.
# FLUENT_DATA_DIR=/data
# Optional: a random secret of at least 32 characters to create the first teacher in the browser.
# FLUENT_SETUP_TOKEN=

# Optional free hosting: use a dedicated Supabase Free project, NOT demo data.
# The runtime database role must have CRUD access only to the private fluent schema.
# Use the IPv4-compatible pooler URL from Supabase Connect, with fluent_runtime.<ref>.
# Never put DATABASE_URL or SUPABASE_SECRET_KEY into frontend code or Git.
# DATABASE_URL=
# FLUENT_HOSTING=free
# FLUENT_STORAGE=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=
# SUPABASE_BUCKET=fluent-private

# SMTP is optional; in-app notifications work without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Optional Telegram bot. Create in BotFather, then run: python manage.py telegram-webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Optional Google Calendar OAuth Web application.
# Redirect URI: https://your-domain/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Zoom Server-to-Server OAuth (your own Zoom account).
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER_ID=me

# Bank integration is intentionally absent. Add your SBP link and QR inside Settings.
